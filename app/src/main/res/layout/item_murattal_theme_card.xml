<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootThemeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_reciter_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.urwah.dhikr.MurattalThemePreview
            android:id="@+id/themePreview"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivThemeSelected"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="12dp"
            android:contentDescription="المظهر الحالي"
            android:src="@drawable/ic_check_circle_24dp"
            android:tint="@color/urwah_thread_brown"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvThemeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/alyamama_bold"
        android:textColor="@color/urwah_thread_dark"
        android:textSize="15sp"
        tools:text="تقليدي" />

</LinearLayout>