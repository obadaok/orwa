<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/urwah_background">

    
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        
        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/urwah_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">

            <TextView android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_segment_active_reader" android:fontFamily="@font/alyamama_bold" android:gravity="center" android:paddingHorizontal="16dp" android:text="حفظ" android:textColor="@color/white" android:textSize="13sp" />

            <TextView android:id="@+id/btnShare" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="16dp" android:text="مشاركة" android:textColor="@color/urwah_thread_dark" android:textSize="13sp" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView android:id="@+id/btnClose" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama_bold" android:gravity="center" android:text="✕" android:textColor="@color/urwah_thread_dark" android:textSize="16sp" />

            <ImageButton android:id="@+id/btnUndo" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/bg_chip_neo" android:contentDescription="تراجع" android:padding="9dp" android:scaleType="centerInside" android:src="@drawable/ic_undo" android:tint="@color/urwah_thread_dark" />

            <ImageButton android:id="@+id/btnRedo" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/bg_chip_neo" android:contentDescription="إعادة" android:padding="9dp" android:scaleType="centerInside" android:src="@drawable/ic_redo" android:tint="@color/urwah_thread_dark" />

            <TextView android:id="@+id/btnPreview" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama_bold" android:gravity="center" android:paddingHorizontal="14dp" android:text="معاينة" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />
        </LinearLayout>

        
        <FrameLayout android:id="@+id/editorContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

            <androidx.core.widget.NestedScrollView android:id="@+id/editorScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:gravity="center">

                <FrameLayout android:id="@+id/previewWrap" android:layout_width="match_parent" android:layout_height="wrap_content">

                    <FrameLayout android:id="@+id/previewFrame" android:layout_width="match_parent" android:layout_height="wrap_content">

                        <LinearLayout android:id="@+id/previewRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="true" android:gravity="center_horizontal" android:orientation="vertical" android:paddingVertical="32dp">

                            
                            <FrameLayout android:id="@+id/tvContentHost" android:layout_width="match_parent" android:layout_height="wrap_content">

                                <TextView android:id="@+id/tvPreviewContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:gravity="start" android:lineSpacingExtra="0dp" android:textColor="@color/urwah_thread_dark" android:textDirection="anyRtl" />

                                <View android:id="@+id/selHandleStart" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|start" android:background="@drawable/bg_selection_handle" android:elevation="4dp" android:visibility="gone" />

                                <View android:id="@+id/selHandleEnd" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|start" android:background="@drawable/bg_selection_handle" android:elevation="4dp" android:visibility="gone" />
                            </FrameLayout>

                            <TextView android:id="@+id/tvPreviewDivider" android:layout_width="match_parent" android:layout_height="1.5dp" android:layout_marginHorizontal="40dp" android:layout_marginTop="48dp" android:background="@color/urwah_thread_light" android:visibility="visible" />

                            <TextView android:id="@+id/tvPreviewMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="12dp" android:fontFamily="@font/alyamama" android:gravity="start" android:maxLines="1" android:singleLine="true" android:textColor="@color/urwah_thread_brown" android:textDirection="anyRtl" android:textSize="13sp" />

                            <LinearLayout android:id="@+id/previewFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">

                                <ImageView android:id="@+id/ivQuoteLogo" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@string/app_name" android:scaleType="fitCenter" android:src="@drawable/ic_splash_logo" />

                                <TextView android:id="@+id/tvBrandLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="@font/alyamama" android:gravity="start" android:text="عبر تطبيق عروة" android:textColor="@color/urwah_thread_brown" android:textDirection="anyRtl" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <ImageView android:id="@+id/ivPreviewBitmap" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone" />

                    <View android:id="@+id/previewBorder" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_quote_preview_border" android:clickable="false" android:focusable="false" android:visibility="gone" />
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>

            
            <LinearLayout android:id="@+id/selectionTools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="72dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_neo_card" android:elevation="8dp" android:orientation="vertical" android:padding="6dp" android:visibility="gone">

                <TextView android:id="@+id/tvSelectionInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingBottom="2dp" android:textColor="@color/urwah_thread_brown" android:textSize="11sp" />

                <HorizontalScrollView android:layout_width="wrap_content" android:layout_height="wrap_content" android:scrollbars="none">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">

                        <TextView android:id="@+id/btnCopy" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="12dp" android:text="نسخ" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <TextView android:id="@+id/btnEffectHighlight" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="12dp" android:text="تمييز" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <TextView android:id="@+id/btnDeleteSelection" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="12dp" android:text="حذف" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <TextView android:id="@+id/btnHideUnselected" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="12dp" android:text="إخفاء غير المحدد" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <TextView android:id="@+id/btnFormat" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="12dp" android:text="تنسيق" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>

        
        <HorizontalScrollView android:id="@+id/toolsToolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/urwah_surface" android:scrollbars="none" android:paddingHorizontal="8dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">

                <TextView android:id="@+id/toolAlign" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="14dp" android:text="محاذاة" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                <TextView android:id="@+id/toolFont" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="14dp" android:text="الخط" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                <TextView android:id="@+id/toolSize" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="14dp" android:text="مقاس" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                <TextView android:id="@+id/toolEffects" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="14dp" android:text="تأثيرات" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                <TextView android:id="@+id/toolBackground" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="14dp" android:text="الخلفية" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                <TextView android:id="@+id/toolMeta" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="14dp" android:text="المصدر" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    
    <FrameLayout android:id="@+id/toolsOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">

        <View android:id="@+id/toolsScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/urwah_overlay_scrim" android:clickable="true" android:focusable="true" />

        <LinearLayout android:id="@+id/toolsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/bg_reader_bottom_panel" android:elevation="12dp" android:orientation="vertical" android:paddingBottom="10dp">

            <View android:layout_width="44dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:background="@drawable/seekbar_thumb" android:id="@+id/toolsHandle" />

            <LinearLayout android:id="@+id/toolsHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/alyamama_bold" android:gravity="center" android:text="أدوات التنسيق" android:textColor="@color/urwah_thread_dark" android:textSize="14sp" />

                <TextView android:id="@+id/btnCloseTools" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:paddingHorizontal="16dp" android:text="تم" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView android:id="@+id/toolsScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingBottom="6dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp">

                    
                    <LinearLayout android:id="@+id/sectionAlign" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="المحاذاة" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">

                        <TextView android:id="@+id/btnAlignRight" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_segment_inactive_reader" android:fontFamily="@font/alyamama" android:gravity="center" android:text="يمين" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                        <TextView android:id="@+id/btnAlignCenter" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_segment_inactive_reader" android:fontFamily="@font/alyamama" android:gravity="center" android:text="وسط" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                        <TextView android:id="@+id/btnAlignLeft" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_segment_inactive_reader" android:fontFamily="@font/alyamama" android:gravity="center" android:text="يسار" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                        <TextView android:id="@+id/btnAlignJustify" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_segment_inactive_reader" android:fontFamily="@font/alyamama" android:gravity="center" android:text="ضبط" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionFont" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="الخط والحجم" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="4dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:text="أ" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                        <SeekBar android:id="@+id/fontSizeSlider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_weight="1" android:max="40" android:progress="18" android:progressDrawable="@drawable/seekbar_progress" android:thumb="@drawable/seekbar_thumb" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:text="أ" android:textColor="@color/urwah_thread_dark" android:textSize="18sp" />
                    </LinearLayout>

                    
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">

                        <LinearLayout android:id="@+id/fontChips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView android:id="@+id/btnBoldAll" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="center" android:layout_marginTop="8dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama_bold" android:gravity="center" android:paddingHorizontal="18dp" android:text="عريض" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionSpacing" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="التباعد" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:text="تباعد الأسطر" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <SeekBar android:id="@+id/lineSpacingSlider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_weight="1" android:max="100" android:progressDrawable="@drawable/seekbar_progress" android:thumb="@drawable/seekbar_thumb" />

                        <TextView android:id="@+id/tvLineSpacingValue" android:layout_width="32dp" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:gravity="end" android:text="1.6x" android:textColor="@color/urwah_thread_brown" android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:text="تباعد الفقرات" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <SeekBar android:id="@+id/paraSpacingSlider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_weight="1" android:max="100" android:progressDrawable="@drawable/seekbar_progress" android:thumb="@drawable/seekbar_thumb" />

                        <TextView android:id="@+id/tvParaSpacingValue" android:layout_width="32dp" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:gravity="end" android:text="1.0x" android:textColor="@color/urwah_thread_brown" android:textSize="11sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionWidth" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="العرض والهامش" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:text="عرض النص" android:textColor="@color/urwah_thread_dark" android:textSize="11sp" />

                        <SeekBar android:id="@+id/textWidthSlider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_weight="1" android:max="100" android:progress="92" android:progressDrawable="@drawable/seekbar_progress" android:thumb="@drawable/seekbar_thumb" />

                        <TextView android:id="@+id/tvTextWidthValue" android:layout_width="36dp" android:layout_height="wrap_content" android:fontFamily="@font/alyamama" android:gravity="end" android:text="92%" android:textColor="@color/urwah_thread_brown" android:textSize="11sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="مقاس الصورة" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/sizeSelector" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="6dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:paddingHorizontal="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionEffects" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="تأثيرات التحديد" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <TextView android:id="@+id/tvEffectsHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/alyamama" android:text="حدّد جزءًا من النص أولًا لتفعيل هذه الأدوات" android:textColor="@color/urwah_thread_light" android:textSize="10sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                            <TextView android:id="@+id/btnEffectBold" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:text="عريض" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                            <TextView android:id="@+id/btnEffectUnderline" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:text="تحته خط" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                            <TextView android:id="@+id/btnEffectScaleUp" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:text="تكبير" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                            <TextView android:id="@+id/btnEffectScaleDown" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:text="تصغير" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                            <TextView android:id="@+id/btnEffectDim" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:text="تعتيم" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                            <TextView android:id="@+id/btnEffectHide" android:layout_width="0dp" android:layout_height="44dp" android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama" android:gravity="center" android:text="إخفاء" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />
                        </LinearLayout>

                        <TextView android:id="@+id/btnClearEffects" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/bg_chip_neo" android:fontFamily="@font/alyamama_bold" android:gravity="center" android:text="مسح كل التأثيرات" android:textColor="@color/urwah_thread_brown" android:textSize="12sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionBackground" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="الخلفية" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/bgSelector" android:layout_width="match_parent" android:layout_height="84dp" android:layout_marginTop="6dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:paddingHorizontal="4dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/urwah_thread_light" android:alpha="0.5" />

                    
                    </LinearLayout><LinearLayout android:id="@+id/sectionMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:fontFamily="@font/alyamama_bold" android:text="المصدر والتعليق" android:textColor="@color/urwah_thread_dark" android:textSize="12sp" />

                    <EditText android:id="@+id/etCitation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_edit_text" android:fontFamily="@font/alyamama" android:hint="مصدر الاقتباس (اختياري)" android:inputType="textMultiLine" android:maxLines="2" android:minHeight="48dp" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textColor="@color/urwah_thread_dark" android:textColorHint="@color/urwah_thread_brown" android:textSize="13sp" />

                    <EditText android:id="@+id/etCommentary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:background="@drawable/bg_edit_text" android:fontFamily="@font/alyamama" android:hint="تعليق على الاقتباس (اختياري)" android:inputType="textMultiLine" android:maxLines="3" android:minHeight="48dp" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textColor="@color/urwah_thread_dark" android:textColorHint="@color/urwah_thread_brown" android:textSize="13sp" />
                </LinearLayout></LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </FrameLayout>

    
    <FrameLayout android:id="@+id/loadingOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/urwah_background" android:clickable="true" android:focusable="true" android:visibility="gone">

        <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminateTint="@color/urwah_primary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="72dp" android:fontFamily="@font/alyamama_bold" android:text="جارٍ تجهيز الصورة…" android:textColor="@color/urwah_thread_dark" android:textSize="14sp" />
    </FrameLayout>
</FrameLayout>