<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playWindowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <View
        android:id="@+id/playWindowDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/playWindowPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_play_window"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@color/urwah_thread_light"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/alyamama"
            android:text="نافذة التلاوة"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:background="@color/urwah_thread_brown" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surah_header_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvPlayWindowReciterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/alyamama"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/urwah_thread_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="مشاري راشد العفاسي" />

            <TextView
                android:id="@+id/tvPlayWindowReciterMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_neo"
                android:fontFamily="@font/alyamama"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/urwah_thread_brown"
                android:textSize="11sp"
                tools:text="حفص عن عاصم" />

            <ImageView
                android:id="@+id/btnPlayWindowReciters"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="تغيير القارئ"
                android:padding="7dp"
                android:src="@drawable/ic_book_quran_24dp"
                android:tint="@color/urwah_thread_dark" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/alyamama"
            android:text="نطاق التشغيل"
            android:textColor="@color/urwah_thread_brown"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayWindowFull"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="@font/alyamama"
                android:text="السورة كاملة"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPlayWindowFromAyah"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_secondary_button"
                android:fontFamily="@font/alyamama"
                android:text="من آية"
                android:textColor="@color/urwah_thread_dark"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPlayWindowRange"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:fontFamily="@font/alyamama"
                android:text="من آية إلى آية"
                android:textColor="@color/urwah_thread_dark"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPlayWindowRepeatAyah"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_neo"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="تكرير الآية"
                    android:src="@drawable/ic_media_repeat"
                    android:tint="@color/urwah_thread_brown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alyamama"
                    android:text="تكرار الآية"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btnPlayWindowResume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_neo"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="استكمال آخر موضع"
                    android:src="@drawable/ic_media_previous"
                    android:tint="@color/urwah_thread_brown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alyamama"
                    android:text="آخر موضع"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btnPlayWindowSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_neo"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tvPlayWindowSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:text="1x"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/alyamama"
                    android:text="السرعة"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayWindowHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/alyamama"
            android:textColor="@color/urwah_thread_light"
            android:textSize="12sp"
            tools:text="التلاوة متوقفة حالياً" />
    </LinearLayout>

</FrameLayout>
