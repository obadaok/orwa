<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/oc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/oc_background">

    <!-- ═══ Toolbar ═══ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/oc_toolbar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        app:title="@string/oc_screen_title"
        app:titleTextAppearance="@style/OC.Text.Subhead"
        app:navigationIconTint="@color/oc_primary"
        app:contentInsetStart="16dp" />

    <!-- ═══ المحتوى القابل للتمرير ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <!-- ═══ بطاقة التقويم: الشهر الهجري + الشبكة ═══ -->
            <FrameLayout
                android:id="@+id/oc_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_calendar_hero"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp">

                    <!-- زخرفة علوية -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_ornament_band"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:tint="@color/oc_primary_60" />

                    <!-- الشهر الهجري + السنة -->
                    <TextView
                        android:id="@+id/tvHijriMonthHeader"
                        style="@style/OC.Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:textSize="24sp"
                        android:textColor="@color/oc_primary_deep" />

                    <!-- الشهر الميلادي المقابل -->
                    <TextView
                        android:id="@+id/tvGregorianMonthHeader"
                        style="@style/OC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="2dp"
                        android:textSize="11sp" />

                    <!-- صف التنقل: السابق | اليوم | التالي -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_day_cell"
                            android:gravity="center"
                            android:text="‹"
                            android:textSize="24sp"
                            android:textColor="@color/oc_primary"
                            android:fontFamily="@font/alyamama_medium"
                            android:contentDescription="@string/oc_prev_month"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tvTodayChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="18dp"
                            android:background="@drawable/bg_chip_pill"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="@string/oc_today"
                            android:textSize="12sp"
                            android:textColor="@color/oc_primary_deep"
                            android:fontFamily="@font/alyamama_semibold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnNextMonth"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_day_cell"
                            android:gravity="center"
                            android:text="›"
                            android:textSize="24sp"
                            android:textColor="@color/oc_primary"
                            android:fontFamily="@font/alyamama_medium"
                            android:contentDescription="@string/oc_next_month"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- فاصل -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/oc_card_stroke" />

                    <!-- صف أسماء الأيام -->
                    <LinearLayout
                        android:id="@+id/weekdayRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />

                    <!-- شبكة أيام الشهر -->
                    <LinearLayout
                        android:id="@+id/dayGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <!-- التاريخ المختار -->
                    <TextView
                        android:id="@+id/tvSelectedDate"
                        style="@style/OC.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="@color/oc_primary" />

                    <!-- العد التنازلي لرمضان -->
                    <TextView
                        android:id="@+id/tvRamadanCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:fontFamily="@font/alyamama_medium"
                        android:textSize="10sp"
                        android:textColor="@color/oc_primary" />

                    <!-- زخرفة سفلية -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/ic_ornament_band"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        app:tint="@color/oc_primary_60" />

                </LinearLayout>
            </FrameLayout>

            <!-- ═══ أسماء الله الحسنى ═══ -->
            <FrameLayout
                android:id="@+id/cardAsmaHusna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_soft"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OC.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/oc_names_title"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvAsmaHusnaName"
                            style="@style/OC.Text.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/oc_primary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAsmaHusnaExplanation"
                        style="@style/OC.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:textSize="11sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                </LinearLayout>
            </FrameLayout>

            <!-- ═══ آية اليوم ═══ -->
            <FrameLayout
                android:id="@+id/cardAyah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_ayah_card"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:gravity="center">

                    <TextView
                        style="@style/OC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oc_ayah_title"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvAyahText"
                        style="@style/OC.Text.Ayah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="20sp"
                        android:lineSpacingMultiplier="1.6"
                        android:gravity="center"
                        android:maxLines="5"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvSurahRef"
                        style="@style/OC.Text.SurahRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnAyahMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:text="@string/oc_read_more"
                        android:textSize="11sp"
                        android:textColor="@color/oc_primary"
                        android:fontFamily="@font/alyamama_medium"
                        android:visibility="gone" />

                </LinearLayout>
            </FrameLayout>

            <!-- ═══ تفسير الآية ═══ -->
            <FrameLayout
                android:id="@+id/cardTafsir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_soft"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:background="@color/oc_primary_24" />

                    <TextView
                        style="@style/OC.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/oc_tafsir_title"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvTafsirText"
                        style="@style/OC.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/btnTafsirMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/oc_read_more"
                        android:textSize="11sp"
                        android:textColor="@color/oc_primary"
                        android:fontFamily="@font/alyamama_medium"
                        android:visibility="gone" />

                </LinearLayout>
            </FrameLayout>

            <!-- ═══ حديث اليوم ═══ -->
            <FrameLayout
                android:id="@+id/cardHadith"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_soft"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <TextView
                        style="@style/OC.Text.Subhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oc_hadith_title"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHadithText"
                        style="@style/OC.Text.Hadith"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/btnHadithMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/oc_read_more"
                        android:textSize="11sp"
                        android:textColor="@color/oc_primary"
                        android:fontFamily="@font/alyamama_medium"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/oc_card_stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvHadithNarrator"
                            style="@style/OC.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp" />

                        <TextView
                            style="@style/OC.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:text="·"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvHadithSource"
                            style="@style/OC.Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- ═══ مأثورات العلماء ═══ -->
            <FrameLayout
                android:id="@+id/cardBenefit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_soft"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/OC.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/oc_scholars_title"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/tvBenefitText"
                            style="@style/OC.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/btnBenefitMore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/oc_read_more"
                            android:textSize="11sp"
                            android:textColor="@color/oc_primary"
                            android:fontFamily="@font/alyamama_medium"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvScholarName"
                        style="@style/OC.Text.SurahRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="10sp"
                        android:textColor="@color/oc_primary" />

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>