<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reader_bottom_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="@color/urwah_thread_light" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/alyamama_bold"
        android:text="الانتقال إلى صفحة"
        android:textColor="@color/urwah_thread_dark"
        android:textSize="18sp" />

    <View
        android:layout_width="48dp"
        android:layout_height="2.5dp"
        android:layout_gravity="center"
        android:layout_marginVertical="12dp"
        android:background="@color/urwah_thread_brown" />

    <!-- Range info -->
    <TextView
        android:id="@+id/tvPageRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/alyamama"
        android:gravity="center"
        android:textColor="@color/urwah_thread_brown"
        android:textSize="14sp" />

    <!-- Page number input -->
    <EditText
        android:id="@+id/etPageNumber"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_search"
        android:fontFamily="@font/alyamama_bold"
        android:gravity="center"
        android:hint="رقم الصفحة"
        android:inputType="number"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/urwah_search_text"
        android:textColorHint="@color/urwah_search_hint"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/urwah_shadow_faint" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnJumpGo"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="@font/alyamama"
            android:text="اذهب"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnJumpCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="@font/alyamama"
            android:text="إلغاء"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
