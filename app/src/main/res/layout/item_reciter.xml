<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dhikr_icon_action"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvReciterCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_ayah_number"
        android:gravity="center"
        android:textColor="@color/urwah_background"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="✓" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvReciterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alyamama"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="15sp"
            tools:text="مشاري راشد العفاسي" />

        <TextView
            android:id="@+id/tvReciterSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/alyamama"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/urwah_thread_light"
            android:textSize="11sp"
            tools:text="حفص عن عاصم • 128kbps" />
    </LinearLayout>
</LinearLayout>
