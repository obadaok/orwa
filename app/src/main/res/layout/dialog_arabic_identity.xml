<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/urwah_thread_dark"
    app:cardBackgroundColor="@color/urwah_card_bg"
    app:contentPadding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_arabic_identity_badge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/alyamama"
                android:gravity="center"
                android:text="@string/arabic_identity_badge"
                android:textColor="@color/urwah_thread_dark"
                android:textSize="34sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/alyamama"
            android:text="@string/arabic_identity_title"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="52dp"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:background="@color/urwah_thread_brown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/alyamama"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="@string/arabic_identity_message"
            android:textColor="@color/urwah_thread_brown"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnArabicIdentityContinue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/urwah_thread_dark"
            android:fontFamily="@font/alyamama"
            android:text="@string/arabic_identity_continue"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>