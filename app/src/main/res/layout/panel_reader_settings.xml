<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_reader_bottom_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@color/urwah_thread_light" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/alyamama_bold"
            android:text="إعدادات القراءة"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="18sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="2.5dp"
            android:layout_gravity="center"
            android:layout_marginVertical="12dp"
            android:background="@color/urwah_thread_brown" />

        <!-- Font size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Font picker button -->
            <LinearLayout
                android:id="@+id/btnFontPicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_neo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="الخط"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentFontName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="حجم الخط"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnFontDecrease"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_segment_inactive_reader"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/alyamama_bold"
                    android:gravity="center"
                    android:text="أ-"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/fontSizeSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/btnFontIncrease"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_segment_inactive_reader"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/alyamama_bold"
                    android:gravity="center"
                    android:text="أ+"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/urwah_shadow_faint" />

        <!-- Line spacing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="تباعد الأسطر"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLineSpacingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/lineSpacingSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/urwah_shadow_faint" />

        <!-- Paragraph spacing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="تباعد الفقرات"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvParaSpacingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/paraSpacingSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/urwah_shadow_faint" />

        <!-- Text alignment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="محاذاة النص"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlignmentValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAlignRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_segment_inactive_reader"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/alyamama"
                    android:gravity="center"
                    android:text="يمين"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnAlignCenter"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_segment_inactive_reader"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/alyamama"
                    android:gravity="center"
                    android:text="وسط"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnAlignJustify"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_segment_inactive_reader"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/alyamama"
                    android:gravity="center"
                    android:text="ممتزج"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/urwah_shadow_faint" />

        <!-- Margin size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="الهوامش"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMarginValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/marginSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/urwah_shadow_faint" />

        <!-- Reading width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:text="عرض منطقة القراءة"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReadingWidthValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/readingWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                android:splitTrack="false" />
        </LinearLayout>

        <!-- Close button -->
        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="@font/alyamama"
            android:text="إغلاق"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
