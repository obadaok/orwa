<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwah_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/urwah_nav_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="رجوع"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/urwah_thread_dark" />

                <TextView
                    android:id="@+id/tvBookTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:gravity="center"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="الإعدادات"
                    android:padding="6dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/urwah_thread_dark" />

                <ImageView
                    android:id="@+id/ivSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/urwah_thread_dark"
                    android:contentDescription="بحث"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvChapterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/urwah_shadow_faint" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp">

                <TextView
                    android:id="@+id/tvChapterContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.6"
                    android:gravity="start"
                    android:textDirection="rtl" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/chapterNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/urwah_nav_bg"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnPrevChapter"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="@font/alyamama"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:text="الفصل السابق"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNextChapter"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="@font/alyamama"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:text="الفصل التالي"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/readingProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            android:thumbOffset="10dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:splitTrack="false"
            android:thumbTint="@null"
            android:layout_marginBottom="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@color/urwah_nav_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnSearchBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/urwah_thread_dark"
            android:contentDescription="رجوع"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ابحث داخل الكتاب..."
            android:fontFamily="@font/alyamama"
            android:textColor="@color/urwah_thread_dark"
            android:textColorHint="@color/urwah_thread_light"
            android:textSize="16sp"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingHorizontal="8dp"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/ivClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_close_black_24dp"
            android:tint="@color/urwah_thread_dark"
            android:contentDescription="مسح"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/urwah_nav_bg"
        android:elevation="8dp"
        android:visibility="gone"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:text="حجم الخط" />

                <TextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/fontSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="14sp"
                    android:text="تباعد الأسطر" />

                <TextView
                    android:id="@+id/tvLineSpacingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/lineSpacingSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
