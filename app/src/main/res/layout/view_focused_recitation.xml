<?xml version="1.0" encoding="utf-8"?>
<!--
    المرتّل — شاشة «قيد التشغيل الآن» بأسلوب مشغّلات الموسيقى الحديثة.
    - سطر قراءة واحد فقط في المنتصف (٤–٦ كلمات) بدل عرض الآية كاملة.
    - أسطح مسطّحة نظيفة بلا ظلال صلبة، وهوية التطبيق (خطوط وألوان) كما هي.
    - الترتيب: شريط علوي مختصر ↓ سطر القراءة (البطل) ↓ معلومات سفلية رفيعة.
    - الألوان تُطبَّق وقت التشغيل من MurattalThemeManager.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/focusedRecitationOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwah_background"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- الشريط العلوي: إغلاق | عنوان السورة + تسمية الوضع | المظهر | تصغير -->
        <LinearLayout
            android:id="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnFocusedClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/focused_exit_desc"
                android:padding="12dp"
                android:src="@drawable/ic_close_black_24dp"
                android:tint="@color/murattal_classic_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFocusedSurahMini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:gravity="center"
                    android:textColor="@color/murattal_classic_text_primary"
                    android:textSize="16sp"
                    tools:text="سُورَةُ البقرة" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:gravity="center"
                    android:text="@string/focused_mode_title"
                    android:textColor="@color/murattal_classic_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFocusedTheme"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/focused_theme_desc"
                android:padding="12dp"
                android:src="@drawable/ic_air_black_24dp"
                android:tint="@color/murattal_classic_text_primary" />

            <ImageButton
                android:id="@+id/btnFocusedMinimize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/focused_minimize_desc"
                android:padding="12dp"
                android:src="@drawable/ic_back_arrow_rtl"
                android:tint="@color/murattal_classic_text_primary" />
        </LinearLayout>

        <!-- منطقة البطل: سطر القراءة الواحد بالمنتصف تماماً -->
        <FrameLayout
            android:id="@+id/focusedAyahArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/focused_mode_tap_hint"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- بطاقة سطر القراءة: ارتفاع ≈ سطرين، نص ظاهر سطر واحد فقط -->
                <LinearLayout
                    android:id="@+id/focusedReadingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_reading_window"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/focusedReadingOrnamentStart"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_ornament_band" />

                    <TextView
                        android:id="@+id/tvFocusedReadingCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:ellipsize="none"
                        android:fontFamily="@font/uthmanic_hafs"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/murattal_classic_text_primary"
                        android:textSize="26sp"
                        tools:text="ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ" />

                    <ImageView
                        android:id="@+id/focusedReadingOrnamentEnd"
                        android:layout_width="26dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_ornament_band" />
                </LinearLayout>

                <!-- رقم الآية من الإجمالي — نص بسيط بلا خلفية/شكل -->
                <TextView
                    android:id="@+id/tvFocusedAyahCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/murattal_classic_text_secondary"
                    android:textSize="12sp"
                    tools:text="الآية ٣ من ٧" />

                <!-- مؤشر تقدّم الآية: خط رفيع عصري بلا مقبض بارز -->
                <ProgressBar
                    android:id="@+id/focusedProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="240dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:splitTrack="false" />
            </LinearLayout>
        </FrameLayout>

        <!-- شريط معلومات سفلي رفيع: القارئ | الجزء والحزب | النسبة -->
        <LinearLayout
            android:id="@+id/focusedInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvFocusedReciter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/alyamama"
                android:maxLines="1"
                android:textColor="@color/murattal_classic_text_secondary"
                android:textSize="13sp"
                tools:text="مشاري راشد العفاسي • ١٢٨ كيلوبت" />

            <TextView
                android:id="@+id/tvFocusedJuzHizb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/alyamama"
                android:textColor="@color/murattal_classic_text_secondary"
                android:textSize="12sp"
                tools:text="الجزء ١ • الحزب ١" />

            <TextView
                android:id="@+id/tvFocusedPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/alyamama"
                android:minWidth="38dp"
                android:gravity="end"
                android:textColor="@color/murattal_classic_accent"
                android:textSize="12sp"
                tools:text="٢٥٪" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
