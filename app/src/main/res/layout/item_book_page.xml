<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwah_background">

    <!-- ورقة الكتاب — تصميم موحّد مع هوية عروة (مسطّح نظيف) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_book_page"
        android:elevation="1dp"
        android:paddingEnd="2dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- عنوان الكتاب -->
                <TextView
                    android:id="@+id/tvPageBookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_light"
                    android:textColor="@color/urwah_thread_light"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="6dp" />

                <!-- عنوان الفصل -->
                <TextView
                    android:id="@+id/tvPageChapterTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama_bold"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <!-- خط فاصل -->
                <View
                    android:id="@+id/dividerTop"
                    android:layout_width="40dp"
                    android:layout_height="1.5dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="14dp"
                    android:background="@color/urwah_thread_light"
                    android:visibility="gone" />

                <!-- نص الكتاب -->
                <TextView
                    android:id="@+id/tvPageContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_naskh"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="18sp"
                    android:lineSpacingMultiplier="1.7"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="full"
                    android:textDirection="rtl"
                    android:justificationMode="inter_word" />

                <!-- رقم الصفحة -->
                <TextView
                    android:id="@+id/tvPageNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_light"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
