<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surah_header_box"
            android:foreground="@drawable/bg_ripple_rounded"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDuaDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_dark"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDuaDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/alyamama"
                    android:textColor="@color/urwah_thread_brown"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginVertical="12dp"
                android:background="@color/urwah_shadow_faint" />

            <TextView
                android:id="@+id/tvDuaDetailArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alyamama"
                android:textColor="@color/urwah_thread_dark"
                android:textSize="24sp"
                android:gravity="center"
                android:textDirection="rtl"
                android:lineSpacingExtra="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginVertical="12dp"
                android:background="@color/urwah_shadow_faint" />

            <TextView
                android:id="@+id/tvDuaDetailTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alyamama"
                android:textColor="@color/urwah_thread_brown"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvDuaDetailSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.55"
                android:fontFamily="@font/alyamama"
                android:textColor="@color/urwah_thread_light"
                android:textSize="11sp"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginVertical="12dp"
                android:background="@color/urwah_shadow_faint" />

            <Button
                android:id="@+id/btnDuaDetailClose"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="@font/alyamama"
                android:text="إغلاق"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
