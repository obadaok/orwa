<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surah_header_box"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/alyamama"
        android:text="اختر القارئ"
        android:textColor="@color/urwah_thread_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:layout_marginVertical="10dp"
        android:background="@color/urwah_thread_brown" />

    <TextView
        android:id="@+id/tvCurrentReciter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/alyamama"
        android:gravity="center"
        android:textColor="@color/urwah_thread_brown"
        android:textSize="13sp"
        tools:text="الحالي: مشاري راشد العفاسي"
        xmlns:tools="http://schemas.android.com/tools" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReciters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/urwah_shadow_faint" />

    <Button
        android:id="@+id/btnCloseReciters"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_secondary_button"
        android:fontFamily="@font/alyamama"
        android:text="إغلاق"
        android:textColor="@color/urwah_thread_dark"
        android:textSize="14sp" />

</LinearLayout>
