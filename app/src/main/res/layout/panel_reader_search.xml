<?xml version="1.0" encoding="utf-8"?>
<!--
    بحث داخل الكتاب — شاشة كاملة:
    حقل البحث في الأعلى ثم الحالة (تحميل/لا نتائج) ثم النتائج مباشرة أسفله.
    الـ Loading يُعرض أثناء البحث ولا تظهر «لا توجد نتائج» قبل اكتماله.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwah_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: العنوان + زر الإغلاق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/alyamama_bold"
            android:text="بحث في الكتاب"
            android:textColor="@color/urwah_thread_dark"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnCloseSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="إغلاق"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close_circle"
            android:tint="@color/urwah_thread_dark" />
    </LinearLayout>

    <!-- Search input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/urwah_thread_light" />

        <EditText
            android:id="@+id/etReaderSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/alyamama"
            android:hint="اكتب للبحث..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/urwah_search_text"
            android:textColorHint="@color/urwah_search_hint"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivClearReaderSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="مسح"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_close_circle"
            android:tint="@color/urwah_thread_light"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Result count and navigation -->
    <LinearLayout
        android:id="@+id/searchNavRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSearchResultCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/alyamama"
            android:textColor="@color/urwah_thread_brown"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSearchPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_neo"
                android:clickable="true"
                android:contentDescription="السابق"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left_24dp"
                android:tint="@color/urwah_thread_dark" />

            <ImageView
                android:id="@+id/ivSearchNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_neo"
                android:clickable="true"
                android:contentDescription="التالي"
                android:focusable="true"
                android:padding="8dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_left_24dp"
                android:tint="@color/urwah_thread_dark" />
        </LinearLayout>
    </LinearLayout>

    <!-- حالة البحث: جارٍ / لا نتائج / حد الأحرف -->
    <FrameLayout
        android:id="@+id/searchStateArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/searchProgress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/urwah_thread_brown" />

        <TextView
            android:id="@+id/tvNoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/alyamama"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="ابدأ الكتابة للبحث..."
            android:textColor="@color/urwah_thread_light"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Results list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="8dp" />

</LinearLayout>
