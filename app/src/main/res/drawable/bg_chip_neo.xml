<?xml version="1.0" encoding="utf-8"?>
<!--
    شريحة "ثانوية" (outline) — تُستخدم للمعلومات المساعدة مثل الجزء/الحزب والنسبة.
    بلا تغيير في الشكل، لكنها الآن تُستخدم عمدًا فقط للمعلومات الثانوية، بينما
    المعلومة الأهم (رقم الآية) انتقلت إلى bg_chip_neo_filled الجديدة لخلق تدرّج
    بصري واضح بدل تساوي كل الشرائح في الأهمية.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/urwah_background" />
    <stroke
        android:width="1.5dp"
        android:color="@color/urwah_thread_dark" />
    <corners android:radius="20dp" />
</shape>
