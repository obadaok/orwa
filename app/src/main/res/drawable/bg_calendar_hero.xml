<?xml version="1.0" encoding="utf-8"?>
<!--
    خلفية بطاقة التقويم: تدرّج بُني هادئ + دوائر هندسية مجزوءة
    ومضلّع ثماني خفيف — زخارف مجردة بدون صور.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- أساس البطاقة: تدرّج بزوايا دائرية -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="@color/oc_primary_08"
                android:centerColor="@color/oc_surface"
                android:endColor="@color/oc_surface" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- دائرة كبيرة أعلى اليمين -->
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="top|end"
        android:top="-70dp"
        android:end="-50dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="@color/oc_primary_24" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- دائرة متوسطة متقاطعة -->
    <item
        android:width="130dp"
        android:height="130dp"
        android:gravity="top|end"
        android:top="8dp"
        android:end="-18dp">
        <shape android:shape="oval">
            <stroke android:width="1.2dp" android:color="@color/oc_primary_14" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- دائرة صغيرة أسفل اليسار -->
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="bottom|start"
        android:bottom="-30dp"
        android:start="-20dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/oc_primary_24" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- مضلّع ثماني خفيف -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center_vertical|end"
        android:end="40dp">
        <rotate
            android:fromDegrees="22.5"
            android:toDegrees="22.5"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <stroke android:width="1dp" android:color="@color/oc_primary_14" />
                <solid android:color="@android:color/transparent" />
                <corners android:radius="16dp" />
            </shape>
        </rotate>
    </item>

</layer-list>