<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="5dp"
        android:right="5dp"
        android:bottom="-8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_shadow" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/urwah_thread_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
