<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="0dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_thread_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item
        android:left="4dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/urwah_thread_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</layer-list>
