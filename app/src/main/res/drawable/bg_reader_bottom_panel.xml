<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:start="5dp"
        android:top="-5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_shadow" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_bg" />
            <stroke
                android:width="2.5dp"
                android:color="@color/urwah_thread_dark" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>

</layer-list>
