<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:right="3dp"
        android:bottom="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_shadow" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/urwah_card_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/urwah_thread_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
